# Copy this file to ~/.hermes/remote-hermes-nodes.env on the coordinator
# machine and replace all placeholders. Do not commit real API keys.

HERMES_NODE_MBP_NAME=MBP
HERMES_NODE_MBP_API_BASE=http://100.x.x.x:8642
HERMES_NODE_MBP_API_KEY=replace-me

HERMES_NODE_PC_AU_NAME=PC_AU
HERMES_NODE_PC_AU_API_BASE=http://100.x.x.x:8643
HERMES_NODE_PC_AU_API_KEY=replace-me

HERMES_NODE_PC_CN_NAME=PC_CN
HERMES_NODE_PC_CN_API_BASE=http://100.x.x.x:8644
HERMES_NODE_PC_CN_API_KEY=replace-me
